# Path to quantized GGUF model
MODEL_PATH=models/model.gguf

# Hardware tuning (adjust GPU layers according to your VRAM)
MODEL_GPU_LAYERS=24
MODEL_THREADS=4
MODEL_CTX_LIMIT=3072

# Optional API keys for external providers
TAVILY_API_KEY=

# HTTP Server settings
ELIZA_HOST=127.0.0.1
ELIZA_PORT=8000
# Optional: set a strong secret token to enforce 'Authorization: Bearer <token>'
ELIZA_API_KEY=
